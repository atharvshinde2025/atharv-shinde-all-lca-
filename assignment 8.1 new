#include <stdio.h>
#include <string.h>

#define MAX_SENSORS 100

// Structure to represent an IoT sensor
struct Sensor {
    int id;
    char type[30];
    float reading;
    float minVal;
    float maxVal;
    char status[15];
};

// Function prototypes using pointers
void acceptSensors(struct Sensor *s, int n);
void classifySensors(struct Sensor *s, int n);
float calculateAverageByType(struct Sensor *s, int n, const char *targetType, int *matchCount);
void displayAbnormalSensors(struct Sensor *s, int n);

int main() {
    struct Sensor sensors[MAX_SENSORS];
    int n, matchCount = 0;
    char searchType[30];
    float avg;

    printf("Enter the number of IoT sensors (1-%d): ", MAX_SENSORS);
    scanf("%d", &n);

    if (n <= 0 || n > MAX_SENSORS) {
        printf("Invalid number of sensors.\n");
        return 1;
    }

    // 1. Accept sensor information
    acceptSensors(sensors, n);

    // 2. Classify each sensor as Normal or Abnormal
    classifySensors(sensors, n);

    // 3. Calculate average reading for a selected sensor type
    printf("\nEnter the Sensor Type to calculate average reading: ");
    scanf(" %[^\n]", searchType);

    avg = calculateAverageByType(sensors, n, searchType, &matchCount);
    if (matchCount > 0) {
        printf("Average reading for '%s' (%d sensors): %.2f\n", searchType, matchCount, avg);
    } else {
        printf("No sensors found matching type '%s'.\n", searchType);
    }

    // 4. Display all abnormal sensors
    displayAbnormalSensors(sensors, n);

    return 0;
}

// Function to accept sensor data using pointer arithmetic
void acceptSensors(struct Sensor *s, int n) {
    for (int i = 0; i < n; i++) {
        printf("\n--- Enter details for Sensor %d ---\n", i + 1);
        printf("Sensor ID: ");
        scanf("%d", &(s + i)->id);

        printf("Sensor Type (e.g., Temperature, Pressure): ");
        scanf(" %[^\n]", (s + i)->type);

        printf("Measured Reading: ");
        scanf("%f", &(s + i)->reading);

        printf("Minimum Allowed Value: ");
        scanf("%f", &(s + i)->minVal);

        printf("Maximum Allowed Value: ");
        scanf("%f", &(s + i)->maxVal);
    }
}

// Function to classify sensors based on [minVal, maxVal] range
void classifySensors(struct Sensor *s, int n) {
    for (int i = 0; i < n; i++) {
        if ((s + i)->reading >= (s + i)->minVal && (s + i)->reading <= (s + i)->maxVal) {
            strcpy((s + i)->status, "Normal");
        } else {
            strcpy((s + i)->status, "Abnormal");
        }
    }
}

// Function to compute average reading for a given sensor type
float calculateAverageByType(struct Sensor *s, int n, const char *targetType, int *matchCount) {
    float sum = 0.0f;
    *matchCount = 0;

    for (int i = 0; i < n; i++) {
        if (strcasecmp((s + i)->type, targetType) == 0) {
            sum += (s + i)->reading;
            (*matchCount)++;
        }
    }

    return (*matchCount > 0) ? (sum / (*matchCount)) : 0.0f;
}

// Function to display all sensors marked as Abnormal
void displayAbnormalSensors(struct Sensor *s, int n) {
    int found = 0;
    printf("\n================ ABNORMAL SENSORS REPORT ================\n");
    printf("%-10s %-18s %-12s %-18s\n", "ID", "Type", "Reading", "Safe Range");
    printf("---------------------------------------------------------\n");

    for (int i = 0; i < n; i++) {
        if (strcmp((s + i)->status, "Abnormal") == 0) {
            printf("%-10d %-18s %-12.2f [%.2f - %.2f]\n",
                   (s + i)->id,
                   (s + i)->type,
                   (s + i)->reading,
                   (s + i)->minVal,
                   (s + i)->maxVal);
            found = 1;
        }
    }

    if (!found) {
        printf("All sensors are operating within normal parameters.\n");
    }
    printf("=========================================================\n");
}
